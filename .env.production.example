# =================================================================
# AutoParts OEM vs Aftermarket SaaS - Production Environment Template
# =================================================================

# 1. Server & Domain Settings
DOMAIN_NAME=parts.yourdomain.com
PORT=8000
ENVIRONMENT=production

# 2. Database Persistence
# Absolute or container-internal path for SQLite WAL database
DB_PATH=/app/data/autoparts.db

# 3. AI Providers API Keys (Optional - Can also be configured via Owner UI)
# System Owner can input and test these keys directly in the Web Dashboard
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=

# 4. Security & JWT Secrets (Optional Overrides)
SECRET_KEY=generate-a-secure-random-32-byte-hex-key-here
